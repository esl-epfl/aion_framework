// ================================================================
//  $top -- starting point: replace with your design.
//
//  A registered 8-bit datapath, so the flow has logic to mine out of the
//  box:  y <= a + b  when sel,  y <= (a & b) ^ y  otherwise.
//  Keep the ports the testbench drives in sync with tb/test_$top.py.
// ================================================================

module $top (
    input  wire       $clock_port,
    input  wire       rst_n,
    input  wire       sel,
    input  wire [7:0] a,
    input  wire [7:0] b,
    output reg  [7:0] y
);
  always @(posedge $clock_port or negedge rst_n) begin
    if (!rst_n)   y <= 8'd0;
    else if (sel) y <= a + b;
    else          y <= (a & b) ^ y;
  end
endmodule
