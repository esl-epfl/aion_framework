# ================================================================
#  $top -- cocotb testbench
#
#  Runs unchanged on the RTL and on every netlist the flow writes (post-
#  synthesis, post-rewrite, post-PnR with SDF), so it drives and samples the
#  top-level ports only, and samples away from the clock edge -- a gate-level
#  netlist with delays changes its outputs after the edge, not on it.
# ================================================================

import random

import cocotb
from cocotb.clock import Clock
from cocotb.triggers import ClockCycles, FallingEdge, RisingEdge

PERIOD_NS = $period_ns


def model(acc: int, sel: int, a: int, b: int) -> int:
    return (a + b) & 0xFF if sel else (a & b) ^ acc


async def reset(dut) -> None:
    dut.rst_n.value = 0
    dut.sel.value = 0
    dut.a.value = 0
    dut.b.value = 0
    await ClockCycles(dut.$clock_port, 2)
    dut.rst_n.value = 1
    await FallingEdge(dut.$clock_port)


@cocotb.test()
async def random_vectors(dut):
    """The registered datapath against its model, 500 random cycles."""
    cocotb.start_soon(Clock(dut.$clock_port, PERIOD_NS, unit="ns").start())
    await reset(dut)
    acc = 0
    rng = random.Random(1)
    for _ in range(500):
        sel, a, b = rng.getrandbits(1), rng.getrandbits(8), rng.getrandbits(8)
        dut.sel.value, dut.a.value, dut.b.value = sel, a, b
        await RisingEdge(dut.$clock_port)
        acc = model(acc, sel, a, b)
        await FallingEdge(dut.$clock_port)
        assert int(dut.y.value) == acc, f"y={int(dut.y.value):#04x}, expected {acc:#04x}"
